# The A2A gateway runs as its own small image. It deliberately does NOT install
# langchain or langgraph: it is a protocol adapter, and keeping it thin keeps it
# fast to build and quick to restart.
#
# This is why src/ui_contract.py has no langchain imports - the gateway needs
# validate_contract and build_joule_manifest, and copying one dependency-light
# module is better than duplicating the contract in two places.
FROM python:3.12-slim

WORKDIR /app

RUN pip install --no-cache-dir \
    "a2a-sdk[http-server]>=0.3.25,<1.0" \
    "starlette>=0.40.0" \
    "uvicorn[standard]>=0.30.0" \
    "aiohttp>=3.9.0"

COPY src/__init__.py ./src/__init__.py
COPY src/ui_contract.py ./src/ui_contract.py
COPY src/gateway ./src/gateway

EXPOSE 9000

CMD ["uvicorn", "src.gateway.server:app", "--host", "0.0.0.0", "--port", "9000"]
