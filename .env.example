# Copy to `.env` and fill in. `.env` is gitignored — never commit real values.
#
# Every value below is deliberately blank. A blank line means "unset": the app
# falls back to its built-in default where one exists, and the comment above
# each key says which ones you must provide. Examples in comments are generic.

# ─────────────────────────────────────────────────────────────────────────────
# STAGE 2 — data access (MCP server)
# ─────────────────────────────────────────────────────────────────────────────
# The MCP server that fronts your business data. The agent never talks to the
# database directly; this server is the only way in.
#   Connection URL becomes: {MCP_BASE_URL}/mcp/sse?scope={MCP_SCOPE}
#
# Required. Host of your MCP server, e.g. https://mcp.example.com
MCP_BASE_URL=
# The scope on that server to connect to, e.g. reports
MCP_SCOPE=

# ─── Pointing this at YOUR OWN MCP server ────────────────────────────────────
# Everything about the connection is configuration. Run
# `python scripts/probe_mcp.py` first — it uses these same values, so if the
# probe lists your tools the agent will reach them too.
#
# Full URL. Overrides the template below entirely. Use it when your server does
# not follow the {base}/mcp/sse?scope={scope} shape, e.g. https://mcp.example.com/mcp
MCP_URL=
# URL shape, using {base} and {scope}. Blank uses {base}/mcp/sse?scope={scope}
MCP_URL_TEMPLATE=
# sse or streamable_http. Blank uses sse.
MCP_TRANSPORT=
# The header your server reads the user's identity from. Blank uses x-mcp-user-email
MCP_USER_HEADER=

# Which tools the agent may call, comma-separated. BLANK MEANS EVERY TOOL the
# scope exposes — convenient when you are pointing at a new server and do not
# know the names yet.
#
# Pin it once you do: reach the agent does not need is surface it can get wrong.
# A name listed here that the server does not have is an error on purpose — an
# agent silently missing its data tool starts guessing instead of failing.
#   e.g. get_open_orders,get_customer_summary
MCP_ALLOWED_TOOLS=

# Who the agent is. The tool descriptions in the prompt are generated from the
# MCP server itself, but this sentence is domain knowledge. Blank uses the
# default in src/agent/prompts.py.
#   e.g. You are a logistics assistant for warehouse supervisors. You answer
#        questions about open orders using read-only reports.
AGENT_PERSONA=

# Domain judgement: which tool answers which kind of question, and what an
# ambiguous phrase means in YOUR data. Blank uses the defaults in
# src/agent/prompts.py.
#
# This is the part tool metadata cannot give you. A schema says a tool exists and
# what arguments it takes; it never says "'who moved most' means rank by this
# column, and there is no history to difference". Budget a few lines here for
# any new server.
#   e.g. - "Delay" means promised versus actual delivery date, already a column.
AGENT_GUIDANCE=

# ─── SET THIS ────────────────────────────────────────────────────────────────
# Required. The user the MCP server scopes every answer to, sent in the identity
# header above. Put your own address here and you get your own data.
#   e.g. jane.doe@example.com
#
# In a fully wired production setup this comes from the Joule principal-
# propagation JWT instead; the workshop deployment does not rely on that, so
# this variable is the identity for every request the agent handles.
MCP_USER_EMAIL=

# ─────────────────────────────────────────────────────────────────────────────
# STAGE 3 — reasoning (SAP Gen AI Hub / AI Core)
# ─────────────────────────────────────────────────────────────────────────────
# Required. Copy these from your SAP AI Core service key. Gen AI Hub resolves
# model names against the deployments in your resource group, so there is no
# per-model endpoint to configure.
AICORE_CLIENT_ID=
# Quote the secret if it contains `$` — dotenv otherwise treats it as interpolation.
AICORE_CLIENT_SECRET=
# e.g. https://<subdomain>.authentication.<region>.hana.ondemand.com
AICORE_AUTH_URL=
# e.g. https://api.ai.<landscape>.hana.ondemand.com/v2
AICORE_BASE_URL=
# The AI Core resource group your models are deployed in, e.g. default
AICORE_RESOURCE_GROUP=

# The model the agent reasons with. Must name a model actually deployed in the
# resource group above, e.g. gpt-4o-mini. Blank uses the default in src/config.py.
AGENT_MODEL=
# The UI synthesizer is a small structured-output call, so it can run on a
# cheaper model than the reasoning turn. Blank uses AGENT_MODEL.
UI_SYNTH_MODEL=
# Upper bound on tokens per model reply. Blank uses 4096.
MAX_TOKENS=

# ─────────────────────────────────────────────────────────────────────────────
# STAGE 4 — delivery (A2A gateway -> Joule)
# ─────────────────────────────────────────────────────────────────────────────
# How the gateway runs a turn (see src/gateway/runner.py). Blank uses http.
#   http   -> post to a LangGraph server. The local workshop path: `langgraph
#             dev` gives you LangGraph Studio and per-node traces.
#   local  -> import the graph and run it in this process. No LangGraph server,
#             no Postgres, no Redis — one process is the whole deployable. This
#             is what Cloud Foundry runs (set in manifest.yml).
AGENT_RUNTIME=

# Where the gateway reaches the LangGraph server. AGENT_RUNTIME=http only.
# Blank uses http://localhost:2024, which is where `langgraph dev` listens.
#   e.g. http://<langgraph-service>:8000 when running under docker compose
LANGGRAPH_API_URL=
# The graph id from langgraph.json. Blank uses the one this repo ships.
LANGGRAPH_GRAPH_ID=

# Public URL of the gateway. Goes into the Agent Card that Joule fetches for
# discovery, so it must be a URL Joule can actually reach — your tunnel or the
# deployed host, not localhost. Blank uses http://localhost:9000 (local only).
#   e.g. https://<your-app>.cfapps.<region>.hana.ondemand.com
A2A_GATEWAY_BASE_URL=
# Seconds the gateway waits for one turn. Blank uses 120.
A2A_TIMEOUT_SECONDS=

# The path the A2A endpoint is served on. Must match the path in the BTP
# destination URL exactly, or Joule gets a bare 404. Blank uses analytics-agent.
A2A_AGENT_PATH=

# Gateway log level. Blank uses INFO, which already logs the identity source,
# the tools bound, every warehouse query and the render the synth chose.
# DEBUG when a turn is behaving strangely.
LOG_LEVEL=

# Optional override. Leave blank — MCP_USER_EMAIL above is the one knob, and
# this falls back to it. Set it only if you want the gateway to answer as a
# different person than probe_mcp.py connects as.
DEV_FALLBACK_USER_EMAIL=

# Needed only by the containerised LangGraph server (docker compose), which sets
# its own values in docker-compose.yaml. Leave blank otherwise.
#   e.g. postgres://<user>:<password>@<host>:5432/<database>
DATABASE_URI=
#   e.g. redis://<host>:6379
REDIS_URI=
