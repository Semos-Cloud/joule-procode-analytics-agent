# Copy to `.env` and fill in. `.env` is gitignored — never commit real values.

# ─────────────────────────────────────────────────────────────────────────────
# STAGE 2 — data access (MCP server)
# ─────────────────────────────────────────────────────────────────────────────
# The MCP server that fronts the business data. The agent never talks to the
# database; this URL is the only way in.
#   Connection URL becomes: {MCP_BASE_URL}/mcp/sse?scope={MCP_SCOPE}
MCP_BASE_URL=https://jobptsapi.semoscloud.com
MCP_SCOPE=analytics

# ─── Pointing this at YOUR OWN MCP server ────────────────────────────────────
# Everything about the connection is configuration. Run
# `python scripts/probe_mcp.py` first — it uses these same values, so if the
# probe lists your tools the agent will reach them too.
#
# Full URL. Overrides the template below entirely. Use it when your server does
# not follow the {base}/mcp/sse?scope={scope} shape.
MCP_URL=
MCP_URL_TEMPLATE={base}/mcp/sse?scope={scope}
# "sse" or "streamable_http"
MCP_TRANSPORT=sse
# The header your server reads identity from.
MCP_USER_HEADER=x-mcp-user-email

# Which tools the agent may call, comma-separated. BLANK MEANS EVERY TOOL the
# scope exposes — convenient when you are pointing at a new server and do not
# know the names yet.
#
# Pin it once you do. This scope offers nine tools; the workshop agent needs
# two, and reach it does not need is surface it can get wrong. A name listed
# here that the server does not have is a startup error, on purpose: an agent
# silently missing its data tool starts guessing instead of failing.
MCP_ALLOWED_TOOLS=get_my_teams_reach_data,get_award_reasons_data

# Who the agent is. The tool descriptions in the prompt are generated from the
# MCP server itself, but this sentence is domain knowledge — rewrite it when you
# point at data that is not recognition data.
AGENT_PERSONA=

# ─── SET THIS ────────────────────────────────────────────────────────────────
# The manager whose team the MCP server scopes every answer to. Sent as the
# `x-mcp-user-email` header. Put YOUR address here and you get YOUR team's data.
#
# In a fully wired production setup this comes from the Joule principal-
# propagation JWT instead; the workshop deployment does not rely on that, so
# this variable is the identity for every request the agent handles.
MCP_USER_EMAIL=

# ─────────────────────────────────────────────────────────────────────────────
# STAGE 3 — reasoning (SAP Gen AI Hub / AI Core)
# ─────────────────────────────────────────────────────────────────────────────
# Service-key values from your SAP AI Core instance. Gen AI Hub resolves model
# names against the deployments in this resource group, so there is no per-model
# endpoint to configure.
AICORE_CLIENT_ID=
# Quote the secret if it contains `$` — dotenv otherwise treats it as interpolation.
AICORE_CLIENT_SECRET=
AICORE_AUTH_URL=
AICORE_BASE_URL=
AICORE_RESOURCE_GROUP=default

# Must name a model actually deployed in the resource group above.
AGENT_MODEL=gpt-4.1-mini
# The UI synthesizer (Stage 4) is a small structured-output call, so it can run
# on a cheaper model than the reasoning turn.
UI_SYNTH_MODEL=gpt-4.1-mini
MAX_TOKENS=4096

# ─────────────────────────────────────────────────────────────────────────────
# STAGE 4 — delivery (A2A gateway -> Joule)
# ─────────────────────────────────────────────────────────────────────────────
# How the gateway runs a turn (see src/gateway/runner.py):
#   http   -> post to a LangGraph server. The local workshop path: `langgraph
#             dev` gives you LangGraph Studio and per-node traces.
#   local  -> import the graph and run it in this process. No LangGraph server,
#             no Postgres, no Redis — one process is the whole deployable. This
#             is what Cloud Foundry runs (set in manifest.yml).
AGENT_RUNTIME=http

# Where the gateway reaches the running LangGraph server. AGENT_RUNTIME=http only.
#   langgraph dev    -> http://localhost:2024   (the local workshop path)
#   docker compose   -> http://langgraph-api:8000
LANGGRAPH_API_URL=http://localhost:2024
LANGGRAPH_GRAPH_ID=team_analytics

# Public URL of the gateway. Goes into the Agent Card that Joule fetches for
# discovery, so it must be the URL Joule can actually reach (your tunnel or the
# deployed host), not localhost.
A2A_GATEWAY_BASE_URL=http://localhost:9000
A2A_TIMEOUT_SECONDS=120

# The path the A2A endpoint is served on. Must match the path in the BTP
# destination URL exactly, or Joule gets a bare 404.
A2A_AGENT_PATH=analytics-agent

# Optional override. Leave blank — MCP_USER_EMAIL above is the one knob, and
# this falls back to it. Set it only if you want the gateway to answer as a
# different person than probe_mcp.py connects as.
DEV_FALLBACK_USER_EMAIL=

# Needed only by the containerised LangGraph server (docker compose).
DATABASE_URI=postgres://postgres:postgres@langgraph-postgres:5432/postgres?sslmode=disable
REDIS_URI=redis://langgraph-redis:6379
